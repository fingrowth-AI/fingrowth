# Database (overridden in docker-compose to use service hostname)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/investmentstrategist

# Redis (overridden in docker-compose to use service hostname)
REDIS_URL=redis://localhost:6379/0

# LLM Provider
OPENAI_API_KEY=your_key

# Data Sources
ALPHA_VANTAGE_API_KEY=your_key
FINNHUB_API_KEY=your_key
SEC_EDGAR_USER_AGENT=YourApp/1.0 (your@email.com)

# Alpaca Paper Trading (paper-api only — never live endpoint)
ALPACA_API_KEY=your_key
ALPACA_SECRET_KEY=your_secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets
